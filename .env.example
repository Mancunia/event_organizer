# Local dev: docker compose up -d (plain Postgres 18)
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wedding"

# Neon: pooled connection for the app, direct connection for migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Base URL for every shared link (invites, scanner links, QR passes, calendar, webhooks).
# Optional on Vercel: falls back to the production domain (previews use their deployment URL).
# Set it when using a custom domain. Never leave it as localhost in production.
APP_URL="http://localhost:3000"

# Generate each with: openssl rand -base64 48
SESSION_SECRET=""
QR_SECRET=""

# Organiser login for /admin
ADMIN_PASSWORD=""

# Used for local numbers without a + prefix (233 = Ghana) and for displaying event times
DEFAULT_COUNTRY_CODE="233"
EVENT_TIMEZONE="Africa/Accra"

# WhatsApp: "console" logs messages locally; "meta" sends through the WhatsApp Cloud API
WA_PROVIDER="console"
WA_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_API_VERSION="v21.0"
WA_VERIFY_TOKEN=""
WA_APP_SECRET=""

# Encrypts clients' own WhatsApp tokens stored per event. Generate with: openssl rand -base64 48
# Changing it makes saved client credentials unreadable (they must be re-entered).
CREDENTIALS_SECRET=""
